# Anthropic / Claude API (required — used for all content generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# X (Twitter) API v2 — All 5 required for auto-posting with --post flag
# Get these from: https://developer.twitter.com/en/portal/dashboard
# Requires Basic ($100/month) or higher access for write permissions
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here

# Reddit API — Optional. If omitted, Reddit source is skipped gracefully.
# Get free credentials at: https://www.reddit.com/prefs/apps (script app type)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
